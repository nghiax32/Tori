# Sao chép thành .env rồi sửa giá trị.  cp .env.example .env

# dev | prod. Ở prod bắt buộc đổi SECRET_KEY, và nút "Đăng nhập dev" bị tắt.
TORI_ENV=dev
# Domain gốc. Local: localhost (hub = http://localhost, app = http://calendar.localhost)
TORI_DOMAIN=localhost
TORI_SCHEME=http
# Chỉ cần khi Caddy không chạy ở cổng 80/443 (ví dụ HTTP_PORT=8080 thì đặt PUBLIC_PORT=8080)
PUBLIC_PORT=

# Khoá ký cookie phiên đăng nhập. Tạo bằng: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Google OAuth (xem docs/deploy.md mục "Google OAuth"). Để trống = chỉ dùng được đăng nhập dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TIMEZONE=Asia/Ho_Chi_Minh

# ----- Docker Compose -----
# Local: tori (image build tại máy). Server: ghcr.io/<github-user-viết-thường>/tori
IMAGE_PREFIX=tori
HTTP_PORT=80
HTTPS_PORT=443
