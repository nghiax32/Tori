{
  "//": "Cấu hình TypeScript dùng chung. App dùng: { \"extends\": \"../../../packages/ui/tsconfig.base.json\", \"include\": [\"src\", \"../../../packages/ui/src\"] }",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@tori/ui": ["./src/index.ts"],
      "@tori/ui/*": ["./src/*"]
    }
  }
}
